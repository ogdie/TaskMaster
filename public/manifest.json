{
  "name": "TaskMaster - Gerenciador de Tarefas",
  "short_name": "TaskMaster",
  "description": "Aplicativo para gerenciar tarefas offline-first com sincronização automática",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#000000",
  "background_color": "#ffffff",
  "orientation": "portrait-primary",
  "categories": ["productivity"],
  
  "icons": [
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "screenshots": [
    {
      "src": "/screenshot-mobile-1.png",
      "sizes": "540x720",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/screenshot-desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],

  "shortcuts": [
    {
      "name": "Criar Tarefa",
      "short_name": "Nova Tarefa",
      "description": "Criar uma nova tarefa rapidamente",
      "url": "/?action=create",
      "icons": [{ "src": "/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Minhas Tarefas",
      "short_name": "Tarefas",
      "description": "Ver minhas tarefas",
      "url": "/?action=list",
      "icons": [{ "src": "/icon-96x96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}

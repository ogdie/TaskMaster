{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",

  "env": {
    "NEXT_PUBLIC_API_URL": "",
    "MONGODB_URI": "",
    "NEXTAUTH_SECRET": "",
    "NEXTAUTH_URL": "",
    "GITHUB_ID": "",
    "GITHUB_SECRET": "",
    "GOOGLE_ID": "",
    "GOOGLE_SECRET": ""
  },

  "headers": [
    {
      "source": "/api/health",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=30, s-maxage=60" }
      ]
    },
    {
      "source": "/api/tasks/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, max-age=0, s-maxage=30" }
      ]
    },
    {
      "source": "/_next/static/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/public/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ],

  "redirects": [
    { "source": "/old-page", "destination": "/", "permanent": true }
  ],

  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],

  "regions": ["sfo1"],

  "functions": {
    "pages/api/**.js": {
      "maxDuration": 60,
      "memory": 512
    }
  },

  "images": {
    "domains": ["localhost", "lh3.googleusercontent.com", "avatars.githubusercontent.com"],
    "formats": ["image/avif", "image/webp"],
    "sizes": [320, 640, 960, 1280, 1920],
    "minimumCacheTTL": 31536000
  }
}
